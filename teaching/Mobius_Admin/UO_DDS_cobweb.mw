<Startup-Code startupcode="macro(SP = DocumentTools:-SetProperty);\012macro(GP = DocumentTools:-GetProperty);\012\012Actions := module()\012\012export Click, Refresh, Drag, EndDrag, DoPlot, Reset, Grade, InitParams, Check, Answer, DoNothing;\012\012# The function InitParams() is called when run inside Maple TA.\012local A, B, Err, Nbr, F, X0, MV, Pts:=Array(1..0), NbrGood :=0, GRAPH, SOL := Array(1..0), myskyblue := ColorTools:-Color([.196, .6, .8]);\012\012InitParams := proc( { a:=0, b:=1, err:=0.05, nbr:=3, f:= (1/2)*x + 1/4, x0 := 0.2, mv:= 0, flag1 := 0 } )\012   local graph1, graph2, graph3, j, xn, yn;\012\012   if (flag1 = 0)  then\012      SP(Button1, visible, false);\012      SP(Button2, visible, false);\012      SP(Label1, visible, false);\012      SP(TextArea1, visible, false);\012   else\012      SP(Button1, visible, true);\012      SP(Button2, visible, true);\012      SP(Label1, visible, true);\012      SP(TextArea1, visible, true);\012   end if;\012   A := a;\012   B := b;\012   Err := err;\012   Nbr := nbr;\012   F := f;\012   X0 := x0;\012   if ( mv = 0 ) then\012      MV := B;\012   else\012      MV := mv;\012   end if;\012\012   xn := X0;\012   yn := 0;\012   ArrayTools[Append](SOL, [xn,yn]);\012   yn := evalf(subs(x=xn, F));\012   ArrayTools[Append](SOL, [xn,yn]);\012   for j from 1 to Nbr-1 do\012      xn := yn;\012      ArrayTools[Append](SOL, [xn,xn]);\012      yn := evalf(subs(x=xn, F));\012      ArrayTools[Append](SOL, [xn,yn]);\012   end do;\012\012   graph1 := plot([[A,A],[B,B]], color=myskyblue, gridlines=true, view=[A..B,0..MV]):\012   graph2 := plot( F, x=A..B, color=black, view=[A..B,0..MV]):\012   # graph3 is used only to ensure that the horizontal axis will be displayed.\012   graph3 := plots[pointplot]([[A,0],[B,0]], symbol=point, color=black):\012   GRAPH := plots[display]([graph1, graph2, graph3]);\012   Reset();\012end proc;\012\012Click := proc()\012   local x, y;\012\012   x := GP('Plot0', 'clickx');\012   y := GP('Plot0', 'clicky');\012\012   ArrayTools[Append](Pts, [x,y]);\012   SP(TextArea0, value, [evalf[6](x),evalf[6](y)]);\012   DoPlot();\012end proc;\012\012Refresh := proc()\012   local x, y, N, coord;\012\009\012   coord := parse(GP('TextArea0','value'));\012   x := coord[1];\012   y := coord[2];\012\012   if ( is(x &lt; A) or is(x &gt; B) ) then \012      return NULL;\012   end if;\012\012   N := numelems(Pts);\012   Pts[N] := [x,y];\012   DoPlot();\012end proc;\012\012Drag := proc()\012   local x, y, N;\012\012   x := GP('Plot0', 'endx');\012   y := GP('Plot0', 'endy');\012   N := numelems(Pts);\012   Pts[N] := [x,y];\012   SP(TextArea0, value, [evalf[6](x),evalf[6](y)]);\012   DoPlot();\012end proc;\012\012EndDrag := proc()\012   return NULL;\012end proc;\012\012DoPlot := proc()\012   local vertices, edges;\012\012   vertices := plots[pointplot](Pts, symbol=solidcircle, symbolsize=10, color=blue):\012   if ( numelems(Pts) &gt; 1 ) then\012      edges := plot(Pts, color=blue);\012      SP(Plot0, value, plots[display]([GRAPH, vertices, edges]));\012   else\012      SP(Plot0, value, plots[display]([GRAPH, vertices]));\012   end if;\012end proc;\012\012Reset := proc()\012   Pts := Array(1..0);\012   NbrGood := 0;\012   SP(Plot0, value, GRAPH);\012   SP(TextArea0, value, &quot;&quot;);\012   SP(TextArea1, value, &quot;&quot;);\012end proc;\012\012Answer := proc()\012   Reset();\012   Pts := SOL;\012   DoPlot();\012end proc;\012\012Check := proc()\012   local N1, N2, j, J:=0, k, pt, d, indices, goodEdges:=Array(1..0), badEdges:=Array(1..0), goodPts:=Array(1..0), badPts:=Array(1..0), badP, goodP;\012\012   N1 := 2*Nbr;\012   indices := Array(1..N1);\012   N2 := numelems(Pts);\012   NbrGood := 0;\012\012   for k from 1 to N1 do\012      if ( k &lt;= N2 ) then\012         pt := Pts[k];\012         d := sqrt((SOL[k][1]-pt[1])^2 + (SOL[k][2]-pt[2])^2);\012         if ( is(d &lt; Err) ) then\012            NbrGood := NbrGood + 1;\012            indices[k] := 1;\012         end if;\012      else\012         break;\012      end if;\012   end do;\012\012   for j from 1 to N1 do\012      if ( j &lt;= N2 ) then\012         if ( indices[j] = 1 ) then\012            ArrayTools[Append](goodPts, Pts[j]);\012            if ( j &gt; 1 ) then\012               if ( J = 1 ) then\012                  ArrayTools[Append](goodEdges, plot([Pts[j-1],Pts[j]], color=green));\012               else\012                  ArrayTools[Append](badEdges, plot([Pts[j-1],Pts[j]], color=red));\012               end if;\012            end if;\012            J := 1;\012         else\012            ArrayTools[Append](badPts, Pts[j]);\012            if ( j &gt; 1 ) then\012               ArrayTools[Append](badEdges, plot([Pts[j-1],Pts[j]], color=red));\012            end if;\012            J := 0;\012         end if;\012      else\012         break;\009\012         # ArrayTools[Append](badPts, SOL[j]);\012         # if ( j-1 = N2 ) then\012         #    ArrayTools[Append](badEdges, plot([Pts[N2],SOL[j]], color=red));\012         # else\012         #    ArrayTools[Append](badEdges, plot([SOL[j-1],SOL[j]], color=red));\012         # end if;\012      end if;\012   end do;\012\009\012   badP := plots[pointplot](badPts,symbol= diagonalcross, symbolsize=15, color=red);\012   goodP := plots[pointplot](goodPts,symbol= solidcircle, symbolsize=10, color=green);\012   SP(Plot0, value, plots[display]([GRAPH, goodP, badP, seq(goodEdges[i],i=1..numelems(goodEdges)),seq(badEdges[i],i=1..numelems(badEdges)) ]));\012end proc;\012\012Grade := proc()\012   local Nbr2;\012\012   Check();\012   Nbr2 := 2*Nbr;\012\012   if ( NbrGood &gt; 3*Nbr/2 ) then\012      SP(TextArea1, value, evalf(NbrGood/Nbr2));\012      return evalf(NbrGood/Nbr2);\012   else\012      SP(TextArea1, value, 0);\012      return 0;\012   end if;\012end proc;\012\012# This is use for object that do not require a code so that we avoid\012# maple to add\012# &quot;use DocumentTools in   ...   end use;&quot;  that Mobius cannot handle. \012DoNothing := proc()\012end proc;\012\012end module;\012\012# Actions:-InitParams( flag1 = 1 );\012\012macro(SP = SP, GP = GP);\012"/>
